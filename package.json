{
  "name": "resume-stack",
  "version": "1.0.0",
  "description": "A simple alternative(?) to InlineJS for transaction resumption alone with dark mode support",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist",
    "demo": "npm run build && cp dist/index.js demo/resume-stack.js && cd demo && python server.py",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "transaction",
    "resumption",
    "payment",
    "dark-mode",
    "typescript",
    "paystack"
  ],
  "author": "Afam-Ifediogor, U. Divine",
  "license": "Unlicense",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.10.5",
    "rollup": "^4.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/definite-d/resume-stack.git"
  },
  "bugs": {
    "url": "https://github.com/definite-d/resume-stack/issues"
  },
  "homepage": "https://github.com/definite-d/resume-stack#readme"
}
